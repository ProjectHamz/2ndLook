# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# .env.local is gitignored. Never commit real keys or paste them in chat.
# Setup steps for each sponsor tool are in REQUIREMENTS.md under "Setup and credits".
# Ask Belal for the shared team keys.

# C: AI pipeline
# Nicrron: every model call (OpenAI-compatible, https://api.nicrron.ai/v1)
NICRRON_API_KEY=
# PRISM by Block Convey: one team workspace, Settings > API Keys
PRISMTRACE_API_KEY=
# Not secret. lib/nicrron.ts falls back to these values if unset.
PRISMTRACE_PROJECT_ID=34ae205a-dca8-4890-b3ce-f52e8098e279
PRISMTRACE_HOST=https://api.prism.blockconvey.com

# B: data and proof points
# akta.pro: Pro plan with promo code DEALFLOW50
AKTA_API_KEY=
# Optional override of the akta.pro base URL. Leave this line commented out to use
# the default in lib/akta.ts; an empty value would break the client.
# AKTA_BASE_URL=https://api.akta.pro
# Optional, only for GitHub signals on dev-tool companies
GITHUB_TOKEN=

# D: core logic and ship
# Leave empty to use the simulated Affinity workspace (demo mode)
AFFINITY_API_KEY=
# Roundtable: see the quick start linked in REQUIREMENTS.md
ROUNDTABLE_SITE_KEY=
ROUNDTABLE_API_KEY=
# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
