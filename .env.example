# 2ndLook environment — copy to .env.local and fill in. NEVER commit real values.
# .env and .env*.local are git-ignored.

# Affinity: "mock" reads the simulated workspace; "live" calls the real v2 API.
AFFINITY_MODE=mock
AFFINITY_API_KEY=

# akta.pro (by Wokelo) — sent as the x-api-key header. Server-side only.
AKTA_API_KEY=
# Optional override if the API base URL differs from the default in lib/akta.ts.
AKTA_BASE_URL=

# Nicrron (AI gateway, OpenAI-compatible). Server-side only.
NICRRON_API_KEY=

# PRISM by Block Convey. Same key value works under either name:
#   PRISM_API_KEY      — used by lib/prism.ts (build-plan convention)
#   PRISMTRACE_API_KEY — used by the live-tracing handshake / HTTP ingest
PRISM_API_KEY=
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=6786a218-8357-4935-9eb7-e99b0d3e0d48
PRISMTRACE_HOST=https://api.prism.blockconvey.com

# Roundtable (Proof of Human) — site key is public; API key is server-side.
ROUNDTABLE_SITE_KEY=
ROUNDTABLE_API_KEY=

# Supabase (Postgres) for the runtime write tables.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# GitHub (optional) — higher rate limit for signals.ts release lookups.
GITHUB_TOKEN=
